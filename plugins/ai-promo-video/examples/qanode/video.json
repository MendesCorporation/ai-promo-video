{
  "version": 1,
  "id": "qanode-promo-30s",
  "title": "QANode — Teste com confiança",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "duration": 30,
  "brand": {
    "name": "QANode",
    "logo": "./logo-transparent.png",
    "accent": "#6366F1",
    "accent2": "#22D3EE",
    "background": "#060609",
    "foreground": "#FAFAFA",
    "fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif"
  },
  "music": {
    "track": "signal-flow",
    "volume": 0.19
  },
  "scenes": [
    {
      "id": "opening",
      "type": "hero",
      "duration": 4.5,
      "eyebrow": "Automação de qualidade",
