      "transition": "zoom",
      "bullets": [
        "Fluxos web inteligentes",
        "APIs e bancos de dados",
        "Execuções com histórico"
      ],
      "align": "left"
    },
    {
      "id": "final-cta",
      "type": "cta",
      "duration": 4.5,
      "eyebrow": "QANode",
      "title": "Teste com confiança.\nEntregue no ritmo.",
      "subtitle": "Comece pelo fluxo crítico do seu produto.",
      "badge": "Transforme seu próximo teste",
      "transition": "fade",
      "align": "center"
    }
  ],
  "output": "./output/qanode-promo-30s.mp4"
