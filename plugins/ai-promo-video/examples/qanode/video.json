      "transition": "zoom",
      "align": "left"
    },
    {
      "id": "visual-editor",
      "type": "product",
      "duration": 5.5,
      "eyebrow": "Canvas visual",
      "title": "Desenhe o teste.\nEntenda cada passo.",
      "subtitle": "Uma visão direta do cenário, das ações e da jornada que precisa funcionar.",
      "media": "./captures/editor.png",
      "transition": "push",
      "focus": {
        "x": 0.61,
        "y": 0.58,
        "scale": 1.14
      },
      "align": "left"
    },
    {
      "id": "scenarios",
      "type": "product",
      "duration": 5,
      "eyebrow": "Tudo organizado",
      "title": "Do cenário à execução,\nsem perder o contexto.",
      "subtitle": "Crie, acompanhe e rode automações no mesmo espaço de trabalho.",
      "media": "./captures/flows.png",
      "transition": "wipe",
      "focus": {
        "x": 0.55,
        "y": 0.5,
        "scale": 1.09
      },
      "align": "left"
    },
    {
      "id": "visibility",
      "type": "metrics",
      "duration": 5.5,
      "eyebrow": "Ambiente demo ao vivo",
      "title": "Sinais claros.\nDecisões rápidas.",
      "subtitle": "O painel transforma cada execução em evidência visível para o time.",
      "media": "./captures/dashboard.png",
      "transition": "push",
      "metrics": [
        { "label": "sucesso nas últimas 24h", "value": "100%" },
        { "label": "duração média", "value": "6.5s" },
        { "label": "falhas hoje", "value": "0" },
        { "label": "execução hoje", "value": "1" }
