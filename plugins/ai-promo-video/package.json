{
  "name": "@ai-promo-video/core",
  "version": "0.7.1",
  "description": "Headless, agent-driven AI promo video capture and motion-rendering toolkit",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MendesCorporation/ai-promo-video.git",
    "directory": "plugins/ai-promo-video"
  },
  "homepage": "https://github.com/MendesCorporation/ai-promo-video#readme",
  "bugs": {
    "url": "https://github.com/MendesCorporation/ai-promo-video/issues"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "ai-promo": "./dist/cli.js",
    "ai-promo-video": "./dist/install.js"
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "skills",
    "test/fixtures/revideo-shader",
    ".codex-plugin",
    ".mcp.json"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-revideo-patches.mjs",
    "revideo:patch": "node scripts/apply-revideo-patches.mjs",
    "revideo:patch:check": "node scripts/apply-revideo-patches.mjs --check",
    "test:revideo-shader": "node scripts/test-revideo-shader.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run audio:generate",
    "test": "vitest run",
    "browser:install": "playwright install chromium",
    "audio:generate": "tsx src/audio/generate-library.ts",
    "qanode:capture": "node dist/cli.js capture examples/qanode/capture.local.json",
    "qanode:render": "node dist/cli.js render examples/qanode/video.json",
    "qanode:advanced": "node dist/cli.js advanced:render examples/qanode/advanced/project.tsx --output examples/qanode/output/qanode-promo-advanced-30s-revised.mp4 --workers 2",
    "benchmark:render": "node dist/cli.js advanced:render examples/motion-benchmark/advanced/project.tsx --output examples/motion-benchmark/output/signalnest-motion-benchmark-kinetic-v3-visuals.mp4 --workers 2 && node dist/cli.js music:mix examples/motion-benchmark/music-mix-kinetic-v3.json",
    "install:universal": "node dist/install.js install",
    "mcp": "node dist/mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "flubber": "^0.4.2",
    "opentype.js": "^2.0.0",
    "playwright": "^1.61.1",
    "postprocessing": "^6.39.2",
    "simplex-noise": "^4.0.3",
    "subtitle": "^4.2.2",
    "three": "^0.181.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/flubber": "^0.4.0",
    "@types/node": "^20.19.37",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.181.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
